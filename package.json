{
  "name": "ugsel-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev:server": "npm run start:dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "test": "npm run test --workspaces",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "turbo": "^1.10.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  }
}